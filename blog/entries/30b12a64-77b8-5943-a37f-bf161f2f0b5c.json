v.pem\", \"w\") as f:\n    f.write(pem_key)\n\ntry:\n    # 2. OpenSSL 명령어로 모듈러스 추출\n    # 명령어: openssl rsa -in temp_priv.pem -modulus -noout\n    result = subprocess.run(\n        [\"openssl\", \"rsa\", \"-in\", \"temp_priv.pem\", \"-modulus\", \"-noout\"],\n        capture_output=True, text=True, check=True\n    )\n    # 결과 예시: Modulus=A0E0...\n    modulus_raw = result.stdout.strip().replace(\"Modulus=\", \"\")\n    modulus_hex = modulus_raw.lower() # 소문자로 변환\n\n    print(f\"=== 1. 모듈러스 (16진수) ===\\n{modulus_hex}\\n\")\n\n    # 3. 서명 생성 (SHA256 사용)\n    # echo -n \"모듈러스값\" | openssl dgst -sha256 -sign temp_priv.pem | base64\n    # -n 옵션을 흉내내기 위해 input 매개변수에 바이트를 직접 넣음\n    sign_process = subprocess.run(\n        [\"openssl\", \"dgst\", \"-sha256\", \"-sign\", \"temp_priv.pem\"],\n        input=modulus_hex.encode('utf-8'), # 16진수 문자열 자체를 메시지로 입력\n        capture_output=True, check=True\n    )\n\n    # 결과 Base64 인코딩\n    signature_b64 = base64.b64encode(sign_process.stdout).decode('utf-8')\n    print(f\"=== 2. 서명 값 (Base64) ===\\n{signature_b64}\")\n\nexcept Exception as e:\n    print(f\"오류 발생: {e}\")\nfinally:\n    # 임시 파일 삭제\n    if os.path.exists(\"temp_priv.pem\"):\n        os.remove(\"temp_priv.pem\")"
