      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "id: asd, pw: asd로 회원가입 요청을 보내고 로그인해봤다."
          }
        ]
      },
      {
        "type": "image",
        "attrs": {
          "assetId": "2a266ad6-f116-5afe-a7ea-a60bb6894311",
          "src": "/assets/uploads/f4cc579e-13cc-539f-892e-99d18f1c4dc8/2a266ad6-f116-5afe-a7ea-a60bb6894311.png",
