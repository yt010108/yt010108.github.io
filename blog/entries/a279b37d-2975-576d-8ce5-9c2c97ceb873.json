            "type": "text",
            "text": "기드라 깃허브에서 11.3.2의 zip 파일을 다운 받는다."
          }
        ]
      },
      {
        "type": "image",
        "attrs": {
          "assetId": "27908937-2f86-5cc0-9d82-7d46f86fc0de",
          "src": "/assets/uploads/a279b37d-2975-576d-8ce5-9c2c97ceb873/27908937-2f86-5cc0-9d82-7d46f86fc0de.png",
          "alt": "",
          "title": null
