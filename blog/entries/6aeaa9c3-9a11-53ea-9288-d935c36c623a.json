          "assetId": "0a965b82-08bc-53b8-882c-e803a46b7308",
          "src": "/assets/uploads/6aeaa9c3-9a11-53ea-9288-d935c36c623a/0a965b82-08bc-53b8-882c-e803a46b7308.png",
