      {
        "type": "image",
        "attrs": {
          "assetId": "5789cef1-8fde-57ee-b66a-4ac2d7940487",
          "src": "/assets/uploads/b77ffb7a-83d8-52e7-b572-1bcec9920ff9/5789cef1-8fde-57ee-b66a-4ac2d7940487.png",
