        }
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "체크리스트를 만들어서 하나씩 전부 확인해야함!!"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "substring()>char()"
          }
        ]
      },
      {
        "type": "image",
        "attrs": {
          "src": "/assets/uploads/7db82a3d-ad9a-4b7e-b6ee-23d5c7b04f29/aad7d2e3-2b8f-4784-97f4-96d710cca676.png",
