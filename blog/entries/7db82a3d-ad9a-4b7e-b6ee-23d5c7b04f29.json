  "doc": {
    "type": "doc",
    "content": [
      {
        "type": "image",
        "attrs": {
          "src": "/assets/uploads/7db82a3d-ad9a-4b7e-b6ee-23d5c7b04f29/78b1ea65-58ef-4362-835e-3d2167ffb149.png",
