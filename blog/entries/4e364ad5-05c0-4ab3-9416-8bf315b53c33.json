        },
        "content": [
          {
            "type": "text",
            "text": "$('#submitbtn').off('click');\n$('#submitbtn').click(function() {\n    var accountnum = $(\"#accountnum option:selected\").val();\n    var salary = $(\"#salary\").val();\n    var productnum = $(\"#Productnum\").val();\n    var productname = $(\"#Productname\").val();\n    var producttype = $(\"#Producttype\").val();\n    var amount = $(\"#Amount\").val();\n    var interest = $(\"#Interest\").val();\n    var maturity = $(\"#Maturity\").val();\n    var maturityunit = $(\"#MaturityUnit\").val();\n\n    if (interest > 200) {\n        interest = 200;\n    }\n\n    if (accountnum == '0') {\n        alert(\"계좌를 선택해 주세요!\");\n    }\n    else {\n        var e2e_data = encrypt(\n            accountnum + \":\" +\n            1000000000+ \":\" +\n            productnum + \":\" +\n            btoa(encodeURIComponent(productname)) + \":\" +\n            100+ \":\" +\n            1000000000+ \":\" +\n            1000000000+ \":\" +\n            maturity + \":\" +\n            maturityunit\n        );\n\n        $.ajax({\n            type: \"POST\",\n            url: \"/practice/practice13/applyproduct/loan/checkinfo\",\n            dataType: \"text\",\n            data: {\"e2e_data\": e2e_data},\n            error: function() {\n                alert('다시 시도해 주세요!');\n            },\n            success: function(data) {\n                var obj = JSON.parse(data);\n\n                if (obj.result == \"Y\") {\n                    window.location.href = obj.url;\n                }\n                else {\n                    alert(\"신용 등급이 낮습니다.\");\n                }\n            }\n        });\n    }\n});"
          }
        ]
      },
