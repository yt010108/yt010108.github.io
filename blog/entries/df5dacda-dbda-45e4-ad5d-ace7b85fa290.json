            "type": "text",
            "text": "<?php\ndeclare(strict_types=1);\n\n// 기본적으로 Linux 전체를 탐색한다. 필요하면 환경 변수로 범위를 좁힌다.\n$rootSetting = getenv('FILE_BROWSER_ROOT') ?: '/';\n$authUser = getenv('FILE_BROWSER_USER') ?: 'yt';\n$authPassword = getenv('FILE_BROWSER_PASSWORD') ?: '1234';\n\n// 실제 경로로 바꾼 뒤 읽을 수 있는 폴더인지 확인한다.\n$root = realpath($rootSetting);\nif ($root === false || !is_dir($root) || !is_readable($root)) {\n    http_response_code(503);\n    exit('FILE_BROWSER_ROOT is not a readable directory.');\n}\n\nheader('Content-Type: text/html; charset=utf-8');\nheader('Cache-Control: no-store');\nheader('X-Content-Type-Options: nosniff');\nheader('X-Frame-Options: DENY');\nheader('Referrer-Policy: no-referrer');\nheader(\"Content-Security-Policy: default-src 'none'; style-src 'unsafe-inline'; script-src 'unsafe-inline'; connect-src 'self'; base-uri 'none'; form-action 'self'\");\n\n// 파일 탐색기 화면은 HTTP 기본 인증을 통과한 경우에만 보여준다.\nif (!hash_equals($authUser, (string) ($_SERVER['PHP_AUTH_USER'] ?? ''))\n    || !hash_equals($authPassword, (string) ($_SERVER['PHP_AUTH_PW'] ?? ''))) {\n    header('WWW-Authenticate: Basic realm=\"WSL File Browser\"');\n    http_response_code(401);\n    exit('Authentication required.');\n}\n\n// 명령과 현재 폴더는 이 브라우저 세션에만 보관한다.\nsession_name('FILE_BROWSER_SESSION');\nsession_start();\n$_SESSION['token'] ??= bin2hex(random_bytes(16));\n$startDirectory = realpath(getenv('HOME') ?: __DIR__) ?: $root;\nif (!insideRoot($startDirectory, $root)) {\n    $startDirectory = $root;\n}\n$shellDirectory = $_SESSION['cwd'] ?? $startDirectory;\nif (!is_string($shellDirectory) || !is_dir($shellDirectory) || !insideRoot($shellDirectory, $root)) {\n    $shellDirectory = $startDirectory;\n}\n$_SESSION['cwd'] = $shellDirectory;\n\nfunction escape(string $value): string\n{\n    // 파일 이름과 내용을 HTML에 출력할 때 태그로 해석되지 않게 한다.\n    return htmlspecialchars($value, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8');\n}\n\nfunction insideRoot(string $path, string $root): bool\n{\n    // 경로가 탐색 시작 폴더 안에 있는지 확인한다.\n    return $root === DIRECTORY_SEPARATOR\n        || $path === $root\n        || strpos($path, $root . DIRECTORY_SEPARATOR) === 0;\n}\n\nfunction resolveInRoot(string $relative, string $root): ?string\n{\n    // .. 또는 심볼릭 링크를 거친 최종 경로도 시작 폴더 밖이면 거부한다.\n    if (strpos($relative, \"\\0\") !== false) {\n        return null;\n    }\n    $path = realpath($root . DIRECTORY_SEPARATOR . ltrim($relative, '/\\\\'));\n    return $path !== false && insideRoot($path, $root) ? $path : null;\n}\n\nfunction relativeToRoot(string $path, string $root): string\n{\n    return $path === $root ? '' : str_replace(DIRECTORY_SEPARATOR, '/', ltrim(substr($path, strlen($root)), DIRECTORY_SEPARATOR));\n}\n\nfunction linkTo(string $kind, string $relative): string\n{\n    return '?' . $kind . '=' . rawurlencode($relative);\n}\n\nfunction sizeLabel($size): string\n{\n    if ($size === false) {\n        return '—';\n    }\n    $units = ['B', 'KB', 'MB', 'GB', 'TB'];\n    $value = (float) $size;\n    $unit = 0;\n    while ($value >= 1024 && $unit < count($units) - 1) {\n        $value /= 1024;\n        $unit++;\n    }\n    return ($unit === 0 ? (string) $size : number_format($value, 1)) . ' ' . $units[$unit];\n}\n\n// 한 명령씩 Bash에서 실행하고 마지막 작업 폴더를 세션에 저장한다.\nif (isset($_GET['command'])) {\n    if (($_SERVER['REQUEST_METHOD'] ?? '') !== 'POST') {\n        http_response_code(405);\n        exit('Method not allowed.');\n    }\n    if (!hash_equals($_SESSION['token'], (string) ($_SERVER['HTTP_X_CSRF_TOKEN'] ?? ''))) {\n        http_response_code(403);\n        exit('Invalid token.');\n    }\n    $command = $_POST['command'] ?? null;\n    if (!is_string($command) || strlen($command) > 4096) {\n        http_response_code(400);\n        exit('Invalid command.');\n    }\n    if (!function_exists('proc_open')) {\n        http_response_code(503);\n        exit('PHP proc_open is unavailable.');\n    }\n    $marker = '__FILE_BROWSER_CWD_' . bin2hex(random_bytes(8)) . '__';\n    $script = $command . \"\\nprintf '\\\\n\" . $marker . \"%s\\\\n' \\\"\\$PWD\\\"\";\n    $process = @proc_open(['/bin/bash', '-c', $script], [\n        0 => ['pipe', 'r'], 1 => ['pipe', 'w'], 2 => ['redirect', 1],\n    ], $pipes, $shellDirectory);\n    if (!is_resource($process)) {\n        http_response_code(503);\n        exit('Could not start Bash.');\n    }\n    fclose($pipes[0]);\n    $output = stream_get_contents($pipes[1]);\n    fclose($pipes[1]);\n    proc_close($process);\n    $position = strrpos($output, \"\\n\" . $marker);\n    if ($position !== false) {\n        $nextDirectory = rtrim(substr($output, $position + strlen($marker) + 1), \"\\r\\n\");\n        $output = substr($output, 0, $position);\n        $nextDirectory = realpath($nextDirectory);\n        if ($nextDirectory !== false && is_dir($nextDirectory) && insideRoot($nextDirectory, $root)) {\n            $shellDirectory = $nextDirectory;\n            $_SESSION['cwd'] = $shellDirectory;\n        }\n    }\n    header('Content-Type: application/json; charset=utf-8');\n    echo json_encode([\n        'output' => $output,\n        'path' => $shellDirectory,\n        'relative' => relativeToRoot($shellDirectory, $root),\n    ], JSON_INVALID_UTF8_SUBSTITUTE | JSON_UNESCAPED_SLASHES);\n    exit;\n}\n\nif (!in_array($_SERVER['REQUEST_METHOD'] ?? 'GET', ['GET', 'HEAD'], true)) {\n    http_response_code(405);\n    exit('Method not allowed.');\n}\n\n// p는 열 폴더, file은 내용을 미리 볼 파일의 상대 경로다.\n$folderParam = $_GET['p'] ?? relativeToRoot($shellDirectory, $root);\n$fileParam = $_GET['file'] ?? null;\nif (!is_string($folderParam) || ($fileParam !== null && !is_string($fileParam))) {\n    http_response_code(400);\n    exit('Invalid path.');\n}\n\n$selectedFile = null;\nif ($fileParam !== null) {\n    $selectedFile = resolveInRoot($fileParam, $root);\n    if ($selectedFile === null || !is_file($selectedFile) || $selectedFile === __FILE__) {\n        http_response_code(404);\n        exit('File not found.');\n    }\n    $directory = dirname($selectedFile);\n} else {\n    $directory = resolveInRoot($folderParam, $root);\n    if ($directory === null || !is_dir($directory)) {\n        http_response_code(404);\n        exit('Folder not found.');\n    }\n    $_SESSION['cwd'] = $shellDirectory = $directory;\n}\n\nif (!is_readable($directory)) {\n    http_response_code(403);\n    exit('Folder is not readable.');\n}\n\n// 현재 폴더의 항목을 수집한다. 링크와 이 스크립트 자체는 목록에서 뺀다.\n$items = [];\ntry {\n    foreach (new DirectoryIterator($directory) as $entry) {\n        if ($entry->isDot() || $entry->isLink() || $entry->getPathname() === __FILE__) {\n            continue;\n        }\n        $isDirectory = $entry->isDir();\n        if (!$isDirectory && !$entry->isFile()) {\n            continue;\n        }\n        $items[] = [\n            'name' => $entry->getFilename(),\n            'path' => $entry->getPathname(),\n            'directory' => $isDirectory,\n            'readable' => $entry->isReadable(),\n            'size' => $isDirectory ? false : @filesize($entry->getPathname()),\n            'modified' => @filemtime($entry->getPathname()),\n        ];\n    }\n} catch (Throwable $error) {\n    http_response_code(403);\n    exit('Folder is not readable.');\n}\n\n// 폴더를 먼저 표시하고, 같은 종류끼리는 이름순으로 정렬한다.\nusort($items, static function (array $a, array $b): int {\n    return ($b['directory'] <=> $a['directory']) ?: strnatcasecmp($a['name'], $b['name']);\n});\n\n$relativeDirectory = relativeToRoot($directory, $root);\n// 파일 미리보기는 앞 256 KB의 UTF-8 텍스트만 표시한다.\n$preview = null;\n$previewMessage = null;\n$truncated = false;\nif ($selectedFile !== null) {\n    if (!is_readable($selectedFile)) {\n        $previewMessage = '읽을 수 없는 파일입니다.';\n    } else {\n        $limit = 256 * 1024;\n        $content = @file_get_contents($selectedFile, false, null, 0, $limit + 1);\n        if ($content === false) {\n            $previewMessage = '파일을 읽을 수 없습니다.';\n        } elseif (preg_match('/[\\x00-\\x08\\x0B\\x0C\\x0E-\\x1F]/', $content)) {\n            $previewMessage = '바이너리 파일은 미리볼 수 없습니다.';\n        } else {\n            $truncated = strlen($content) > $limit;\n            $content = substr($content, 0, $limit);\n            // 읽기 한도가 UTF-8 문자 중간에 걸리면 마지막 바이트를 걷어낸다.\n            for ($i = 0; $i < 3 && $truncated && preg_match('//u', $content) !== 1; $i++) {\n                $content = substr($content, 0, -1);\n            }\n            if (preg_match('//u', $content) === 1) {\n                $preview = $content;\n            } else {\n                $previewMessage = 'UTF-8 텍스트만 미리볼 수 있습니다.';\n            }\n        }\n    }\n}\n?>\n<!doctype html>\n<html lang=\"ko\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>파일 탐색기</title>\n<style>\n  :root { font-family: Arial, sans-serif; color: #111; background: white; }\n  * { box-sizing: border-box; }\n  body { margin: 0; }\n  .shell { display: grid; grid-template-columns: minmax(360px, 1fr) minmax(0, 1fr); grid-template-rows: minmax(240px, 1fr) minmax(240px, 1fr); height: 100vh; }\n  .terminal-panel { grid-column: 1; grid-row: 1; display: flex; flex-direction: column; min-height: 0; border-right: 1px solid #999; border-bottom: 1px solid #999; }\n  .terminal-title { padding: 7px 10px; font-size: 14px; border-bottom: 1px solid #999; }\n  .terminal { flex: 1; min-height: 0; overflow: auto; padding: 8px; background: #292929; color: #eee; font: 14px/1.4 Consolas, monospace; }\n  .terminal pre { font: inherit; white-space: pre-wrap; }\n  .command-line { display: flex; align-items: baseline; }\n  .command-line span { color: #9f9; white-space: pre; }\n  .command-line input { flex: 1; min-width: 0; border: 0; outline: 0; background: transparent; color: inherit; font: inherit; }\n  .explorer { grid-column: 1; grid-row: 2; min-height: 0; overflow: auto; padding: 8px 10px; border-right: 1px solid #999; }\n  main { grid-column: 2; grid-row: 1 / span 2; min-width: 0; overflow: auto; padding: 8px 12px; }\n  h1 { margin: 8px 0 18px; font-size: 28px; }\n  h2 { margin: 8px 0; font-size: 18px; }\n  a { color: #00e; text-decoration: underline; }\n  a:visited { color: #551a8b; }\n  hr { border: 0; border-top: 1px solid #888; margin: 10px 0; }\n  table { width: 100%; border-collapse: collapse; font-size: 14px; }\n  th, td { padding: 4px 8px; text-align: left; vertical-align: top; }\n  th { color: #00e; text-decoration: underline; font-weight: normal; border-bottom: 1px solid #888; }\n  td.name { overflow-wrap: anywhere; }\n  .icon { display: inline-block; width: 24px; }\n  .size { text-align: right; white-space: nowrap; }\n  .modified { white-space: nowrap; }\n  pre { margin: 0; font: 13px/1.5 Consolas, monospace; white-space: pre-wrap; overflow-wrap: anywhere; }\n  .note { font-size: 12px; color: #555; }\n  @media (max-width: 850px) { .modified { display: none; } }\n  @media (max-width: 700px) { .shell { display: flex; flex-direction: column; height: auto; min-height: 100vh; } .terminal-panel { height: 35vh; min-height: 230px; } .explorer { max-height: 45vh; border-right: 0; } main { min-height: 35vh; border-top: 1px solid #999; } }\n</style>\n</head>\n<body>\n<div class=\"shell\">\n  <section class=\"terminal-panel\" aria-label=\"Shell\">\n    <div class=\"terminal-title\">Shell</div>\n    <div class=\"terminal\" id=\"terminal\">\n      <pre id=\"terminal-output\"></pre>\n      <form class=\"command-line\" id=\"command-form\"><span id=\"prompt\"></span><input id=\"command-input\" autocomplete=\"off\" spellcheck=\"false\" aria-label=\"Command input\"></form>\n    </div>\n  </section>\n  <section class=\"explorer\" aria-label=\"파일 탐색기\" data-directory=\"<?= escape($directory) ?>\">\n    <h1>Index of <?= escape($directory) ?></h1>\n    <hr>\n    <table>\n      <thead><tr><th>Name</th><th class=\"modified\">Last modified</th><th class=\"size\">Size</th></tr></thead>\n      <tbody>\n      <?php if ($relativeDirectory !== ''): ?>\n        <?php $parent = strrpos($relativeDirectory, '/'); $parent = $parent === false ? '' : substr($relativeDirectory, 0, $parent); ?>\n        <tr><td class=\"name\"><span class=\"icon\">↩</span><a href=\"<?= escape(linkTo('p', $parent)) ?>\">Parent Directory</a></td><td class=\"modified\">-</td><td class=\"size\">-</td></tr>\n      <?php endif; ?>\n      <?php foreach ($items as $item): $relative = relativeToRoot($item['path'], $root); ?>\n        <tr>\n          <td class=\"name\"><span class=\"icon\"><?= $item['directory'] ? '📁' : '📄' ?></span><?php if ($item['readable']): ?><a href=\"<?= escape(linkTo($item['directory'] ? 'p' : 'file', $relative)) ?>\"><?= escape($item['name']) ?><?= $item['directory'] ? '/' : '' ?></a><?php else: ?><?= escape($item['name']) ?><?php endif; ?></td>\n          <td class=\"modified\"><?= $item['modified'] === false ? '-' : escape(date('Y-m-d H:i', $item['modified'])) ?></td>\n          <td class=\"size\"><?= $item['directory'] ? '-' : escape(sizeLabel($item['size'])) ?></td>\n        </tr>\n      <?php endforeach; ?>\n      <?php if ($items === []): ?><tr><td colspan=\"3\">Empty directory</td></tr><?php endif; ?>\n      </tbody>\n    </table>\n    <hr>\n  </section>\n  <main>\n    <h1>File contents</h1>\n    <hr>\n    <?php if ($selectedFile !== null): ?>\n      <h2><?= escape(basename($selectedFile)) ?></h2>\n      <?php if ($previewMessage !== null): ?><p><?= escape($previewMessage) ?></p><?php else: ?><pre><?= escape($preview ?? '') ?></pre><?php endif; ?>\n      <?php if ($truncated): ?><p class=\"note\">처음 256 KB만 표시합니다.</p><?php endif; ?>\n    <?php else: ?>\n      <p>왼쪽에서 파일을 선택하세요.</p>\n    <?php endif; ?>\n  </main>\n</div>\n<script>\nlet shownDirectory = <?= json_encode($directory, JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT | JSON_INVALID_UTF8_SUBSTITUTE | JSON_UNESCAPED_SLASHES) ?>;\nlet shellDirectory = <?= json_encode($shellDirectory, JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT | JSON_INVALID_UTF8_SUBSTITUTE | JSON_UNESCAPED_SLASHES) ?>;\nconst csrfToken = <?= json_encode($_SESSION['token']) ?>;\nconst promptPrefix = <?= json_encode((get_current_user() ?: 'user') . '@' . (gethostname() ?: 'linux') . ':', JSON_INVALID_UTF8_SUBSTITUTE) ?>;\nconst terminal = document.querySelector('#terminal');\nconst output = document.querySelector('#terminal-output');\nconst input = document.querySelector('#command-input');\nconst prompt = document.querySelector('#prompt');\nlet pageRequest = 0;\n\nfunction updatePrompt() { prompt.textContent = promptPrefix + shellDirectory + '$ '; }\nupdatePrompt();\n\n// 탐색기와 파일 내용만 바꿔서 위쪽 명령 기록을 유지한다.\nasync function showPage(url, historyMode) {\n  const request = ++pageRequest;\n  const response = await fetch(url, { cache: 'no-store', credentials: 'same-origin' });\n  if (!response.ok) throw new Error('폴더를 열 수 없습니다.');\n  const documentCopy = new DOMParser().parseFromString(await response.text(), 'text/html');\n  const explorer = documentCopy.querySelector('.explorer');\n  const content = documentCopy.querySelector('main');\n  if (request !== pageRequest) return;\n  if (!explorer || !content) throw new Error('페이지를 읽을 수 없습니다.');\n  document.querySelector('.explorer').replaceWith(explorer);\n  document.querySelector('main').replaceWith(content);\n  shownDirectory = explorer.dataset.directory;\n  if (historyMode === 'push') history.pushState(null, '', url);\n  if (historyMode === 'replace') history.replaceState(null, '', url);\n}\n\ndocument.addEventListener('click', (event) => {\n  if (!(event.target instanceof Element)) return;\n  const link = event.target.closest('.explorer a[href^=\"?\"]');\n  if (!link || event.button !== 0 || event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;\n  event.preventDefault();\n  (async () => {\n    await showPage(link.href, 'push');\n    if (new URL(link.href).searchParams.has('p')) {\n      shellDirectory = shownDirectory;\n      updatePrompt();\n    }\n  })().catch(() => { location.href = link.href; });\n});\n\nwindow.addEventListener('popstate', () => {\n  (async () => {\n    await showPage(location.href, 'none');\n    if (new URL(location.href).searchParams.has('p')) {\n      shellDirectory = shownDirectory;\n      updatePrompt();\n    }\n  })().catch(() => { location.reload(); });\n});\n\n// 명령 실행 후 바뀐 작업 폴더를 탐색기에도 반영한다.\ndocument.querySelector('#command-form').addEventListener('submit', async (event) => {\n  event.preventDefault();\n  const command = input.value;\n  if (!command.trim()) return;\n  input.value = '';\n  input.disabled = true;\n  output.textContent += prompt.textContent + command + '\\n';\n  try {\n    const response = await fetch('?command=1', {\n      method: 'POST', credentials: 'same-origin',\n      headers: { 'X-CSRF-Token': csrfToken, 'Content-Type': 'application/x-www-form-urlencoded' },\n      body: new URLSearchParams({ command }),\n    });\n    if (!response.ok) throw new Error('Command failed (' + response.status + ')');\n    const result = await response.json();\n    output.textContent += result.output + (result.output && !result.output.endsWith('\\n') ? '\\n' : '');\n    shellDirectory = result.path;\n    updatePrompt();\n    if (shellDirectory !== shownDirectory) await showPage('?p=' + encodeURIComponent(result.relative), 'replace');\n  } catch (error) {\n    output.textContent += error.message + '\\n';\n  } finally {\n    input.disabled = false;\n    input.focus();\n    terminal.scrollTop = terminal.scrollHeight;\n  }\n});\n</script>\n</body>\n</html>\n"
          }
        ]
      },
      {
        "type": "paragraph"
      }
    ]
  }
}
