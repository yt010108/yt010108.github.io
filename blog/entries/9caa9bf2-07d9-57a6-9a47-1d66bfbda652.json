            "text": "model = Sequential([\n    Dense(128, activation=\"relu\", input_shape=(784,)),\n    Dense(64, activation=\"relu\"),\n    Dense(10, activation=\"softmax\")\n])\n\nmodel.compile(\n    optimizer=\"adam\",\n    loss=\"sparse_categorical_crossentropy\",\n    metrics=[\"accuracy\"]\n)\n"
          }
