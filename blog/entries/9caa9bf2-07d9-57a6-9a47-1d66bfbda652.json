            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Pipeline은 사전학습 모델을 빠르게 추론해보는 가장 간단한 방법이다."
                  }
                ]
              }
            ]
          }
        ]
      }
