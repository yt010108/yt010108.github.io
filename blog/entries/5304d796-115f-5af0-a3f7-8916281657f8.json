      {
        "type": "codeBlock",
        "attrs": {
          "language": ""
        },
        "content": [
          {
            "type": "text",
            "text": "git remote add origin https://github.com/사용자이름/저장소이름.git\ngit remote -v\ngit push -u origin main"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "origin",
            "marks": [
              {
                "type": "code"
              }
