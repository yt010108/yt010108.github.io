          },
          {
            "type": "text",
            "text": "은 원격 저장소에 붙이는 기본 별칭이다. "
          },
          {
            "type": "text",
            "text": "git remote -v",
            "marks": [
              {
                "type": "code"
              }
            ]
          },
          {
            "type": "text",
            "text": "로 연결된 주소를 확인할 수 있다. 처음 "
          },
          {
            "type": "text",
            "text": "push",
            "marks": [
              {
                "type": "code"
              }
            ]
          },
          {
            "type": "text",
            "text": "할 때 "
          },
