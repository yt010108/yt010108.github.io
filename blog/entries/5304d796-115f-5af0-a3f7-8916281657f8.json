      },
      {
        "type": "codeBlock",
        "attrs": {
          "language": ""
        },
        "content": [
          {
            "type": "text",
            "text": "git switch -c dev\ngit switch main\ngit branch -l\ngit merge dev"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
