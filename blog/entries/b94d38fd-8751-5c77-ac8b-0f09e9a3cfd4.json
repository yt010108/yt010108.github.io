        "type": "codeBlock",
        "attrs": {
          "language": ""
        },
        "content": [
          {
            "type": "text",
            "text": "--network none\n--read-only\n--cap-drop ALL\n--security-opt no-new-privileges\n--pids-limit\n--memory\n--cpus\n"
          }
        ]
