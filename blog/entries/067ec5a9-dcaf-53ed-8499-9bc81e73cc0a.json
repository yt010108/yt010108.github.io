          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "0x"
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "db에서 query에 no = (GET 요청 no값)형식으로 데이터를 입력한다."
          }
        ]
      },
      {
        "type": "codeBlock",
        "attrs": {
          "language": "php"
        },
        "content": [
          {
            "type": "text",
            "text": "<?php\n  include \"../../config.php\";\n  if($_GET['view_source']) view_source();\n?><html>\n<head>\n<title>Challenge 27</title>\n</head>\n<body>\n<h1>SQL INJECTION</h1>\n<form method=get action=index.php>\n<input type=text name=no><input type=submit>\n</form>\n<?php\n  if($_GET['no']){\n  $db = dbconnect();\n  if(preg_match(\"/#|select|\\(| |limit|=|0x/i\",$_GET['no'])) exit(\"no hack\");\n  $r=mysqli_fetch_array(mysqli_query($db,\"select id from chall27 where id='guest' and no=({$_GET['no']})\")) or die(\"query error\");\n  if($r['id']==\"guest\") echo(\"guest\");\n  if($r['id']==\"admin\") solve(27); // admin's no = 2\n}\n?>\n<br><a href=?view_source=1>view-source</a>\n</body>\n</html>"
          }
        ]
      },
      {
        "type": "paragraph"
      },
      {
        "type": "horizontalRule"
      },
      {
