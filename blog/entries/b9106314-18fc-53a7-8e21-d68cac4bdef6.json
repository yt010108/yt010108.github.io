          "alt": "",
          "title": null
        }
      },
      {
        "type": "paragraph"
      },
      {
        "type": "image",
        "attrs": {
          "assetId": "7bb55acd-b14c-51d1-beeb-56467915b85e",
          "src": "/assets/uploads/b9106314-18fc-53a7-8e21-d68cac4bdef6/7bb55acd-b14c-51d1-beeb-56467915b85e.png",
          "alt": "",
          "title": null
        }
      },
      {
        "type": "horizontalRule"
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "4. 요약"
          }
        ]
      },
      {
        "type": "paragraph"
      },
      {
        "type": "bulletList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "PHP의 str_replace로 길이가 늘어난 문자열이 substr로 잘리면서 마지막 문자가 변조되는 취약점을 이용한다."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "length(id)는 DB 테이블에 저장된 값을 검사하며, MySQL은 문자열 비교 시 끝 공백ㅜ을 무시하는 특성이 있다."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "admin 뒤에 공백 9개와 '를 입력해, ''가 '로 잘리게 만들고 공백 무시 특성을 통해 admin 계정으로 로그인에 성공했다."
                  }
                ]
              }
            ]
          }
        ]
      },
