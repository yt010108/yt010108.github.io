              }
            ]
          }
        ]
      },
      {
        "type": "horizontalRule"
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "2. 문제 분석"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "들어가면 까만 화면과 view-source가 나온다."
          }
        ]
      },
      {
        "type": "image",
        "attrs": {
          "assetId": "92cc5856-9769-5d3d-99b5-51ff35623402",
          "src": "/assets/uploads/bc899cc8-0a1b-5bcb-b3eb-85d6966b409f/92cc5856-9769-5d3d-99b5-51ff35623402.png",
          "alt": "",
          "title": null
        }
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "소스는 아래와 같다."
          }
        ]
      },
      {
        "type": "codeBlock",
        "attrs": {
          "language": "php"
        },
        "content": [
          {
            "type": "text",
            "text": "<?php\n  include \"../../config.php\";\n  if($_GET['view_source']) view_source();\n?><html>\n<head>\n<title>Challenge 26</title>\n<style type=\"text/css\">\nbody { background:black; color:white; font-size:10pt; }    \na { color:lightgreen; }\n</style>\n</head>\n<body>\n<?php\n  if(preg_match(\"/admin/\",$_GET['id'])) { echo\"no!\"; exit(); }\n  $_GET['id'] = urldecode($_GET['id']);\n  if($_GET['id'] == \"admin\"){\n    solve(26);\n  }\n?>\n<br><br>\n<a href=?view_source=1>view-source</a>\n</body>\n</html>"
          }
        ]
      },
      {
        "type": "paragraph"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "소스에서는 preg_match를 통해 /admin/과 get['id']값을 비교해 같으면 no를 반환하고 종료한다."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "그리고 urldecode를 하고 admin과 같으면 solve(26)이 반환된다."
          }
        ]
      },
      {
        "type": "paragraph"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "그러면 preg_match할때는 인코딩 되어 있으면서 if문에서는 디코딩한 값이 admin이면 문제가 풀린다."
          }
        ]
      },
      {
        "type": "horizontalRule"
      },
      {
        "type": "paragraph"
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "3. 풀이"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "아래와 같이 get의 id인자값에 %2561dmin값을 입력하면 첫 번째에서는 %61dmin이 첫 번째 비교이며 두번째에는 admin이 되서 통과한다."
          }
        ]
      },
      {
        "type": "image",
        "attrs": {
          "assetId": "e0656c30-a01b-509a-9d3c-7022e4c9b07b",
          "src": "/assets/uploads/bc899cc8-0a1b-5bcb-b3eb-85d6966b409f/e0656c30-a01b-509a-9d3c-7022e4c9b07b.png",
          "alt": "",
          "title": null
        }
      },
      {
        "type": "horizontalRule"
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "4. 요약"
          }
        ]
      },
      {
        "type": "paragraph"
      },
      {
        "type": "bulletList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "소스 코드는 preg_match로 \"admin\"을 먼저 필터링하지만, 이후 urldecode를 추가로 수행하여 필터링을 무시하는 취약점이 있다."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "PHP 서버가 $_GET 입력값을 받을 때 자동으로 한 번 디코딩한다는 점을 고려하여, 필터링은 피하고 최종 비교 값은 \"admin\"이 되도록 만들어야 한다."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "이중 URL 인코딩(Double URL Encoding) 값인 %2561dmin을 입력하면, 필터링 단계는 %61dmin으로 통과하고 이후 코드 내의 디코딩을 통해 admin으로 변환되어 문제가 해결된다."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "paragraph"
      }
    ]
  },
