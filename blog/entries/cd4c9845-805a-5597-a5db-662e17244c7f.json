            "text": "2. 문제 분석"
          }
        ]
      },
      {
        "type": "image",
        "attrs": {
          "assetId": "07c1048b-29c2-5161-842e-c5c1a464f2a3",
          "src": "/assets/uploads/cd4c9845-805a-5597-a5db-662e17244c7f/07c1048b-29c2-5161-842e-c5c1a464f2a3.png",
          "alt": "",
          "title": null
        }
      },
      {
        "type": "paragraph"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "client 아이피랑 agent가 나오고 wrong ip가 나온다. 코드는 아래와 같다."
          }
        ]
      },
      {
        "type": "codeBlock",
        "attrs": {
          "language": "php"
        },
        "content": [
          {
            "type": "text",
            "text": "<?php\n  include \"../../config.php\";\n  if($_GET['view_source']) view_source();\n?><html>\n<head>\n<title>Challenge 24</title>\n</head>\n<body>\n<p>\n<?php\n  extract($_SERVER);\n  extract($_COOKIE);\n  $ip = $REMOTE_ADDR;\n  $agent = $HTTP_USER_AGENT;\n  if($REMOTE_ADDR){\n    $ip = htmlspecialchars($REMOTE_ADDR);\n    $ip = str_replace(\"..\",\".\",$ip);\n    $ip = str_replace(\"12\",\"\",$ip);\n    $ip = str_replace(\"7.\",\"\",$ip);\n    $ip = str_replace(\"0.\",\"\",$ip);\n  }\n  if($HTTP_USER_AGENT){\n    $agent=htmlspecialchars($HTTP_USER_AGENT);\n  }\n  echo \"<table border=1><tr><td>client ip</td><td>{$ip}</td></tr><tr><td>agent</td><td>{$agent}</td></tr></table>\";\n  if($ip==\"127.0.0.1\"){\n    solve(24);\n    exit();\n  }\n  else{\n    echo \"<hr><center>Wrong IP!</center>\";\n  }\n?><hr>\n<a href=?view_source=1>view-source</a>\n</body>\n</html>"
          }
        ]
      },
      {
        "type": "paragraph"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "_server와 _cookie값을 추출해서 ip값으로 쓴다."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "_cookie값으로 Remote_addr을 써서 검사를 통과해야한다. .., 12,7. 0.을 공백으로 바꾼다."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "$ip = htmlspecialchars($REMOTE_ADDR); "
          },
          {
            "type": "hardBreak"
          },
          {
            "type": "text",
            "text": " $ip = str_replace(\"..\",\".\",$ip); "
          },
          {
            "type": "hardBreak"
          },
          {
            "type": "text",
            "text": " $ip = str_replace(\"12\",\"\",$ip); "
          },
          {
            "type": "hardBreak"
          },
          {
            "type": "text",
            "text": " $ip = str_replace(\"7.\",\"\",$ip); "
          },
          {
            "type": "hardBreak"
          },
          {
            "type": "text",
            "text": " $ip = str_replace(\"0.\",\"\",$ip);"
          }
        ]
      },
      {
        "type": "horizontalRule"
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "3. 풀이"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "replace를 통과하고 if($ip==\"127.0.0.1\")에 통과하기 위해서 "
          },
          {
            "type": "hardBreak"
          },
          {
            "type": "text",
            "text": "112277.12.0012.12.00.12.1를 REMOTE_ADDR에 cookie값으로 입력하면 통과한다."
          }
        ]
      },
      {
