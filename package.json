{
  "name": "yt010108-blog",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Static security blog and local writing editor",
  "scripts": {
    "build:editor": "node scripts/build-editor.mjs",
    "build:content": "node scripts/build-content.mjs",
    "build:dashboard": "node scripts/build-dashboard.mjs",
    "build:site": "node scripts/build-site.mjs",
    "build": "npm run build:editor && npm run build:dashboard && npm run build:site && npm run build:content && node scripts/prepare-site.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-image": "3.32.0",
    "@tiptap/extension-placeholder": "3.32.0",
    "@tiptap/extension-table": "3.32.0",
    "@tiptap/markdown": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "fflate": "0.8.3",
    "lucide": "1.61.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
